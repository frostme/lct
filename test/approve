#!/usr/bin/env bash
set -euo pipefail

#USAGE arg "<spec>" help="Test spec to run (optional, runs all tests if not provided)" default=""
#USAGE complete "spec" run="printf '%s\n' test/*_spec.sh | xargs -n1 basename"

source test/suite_setup.sh
source test/approvals.bash

trap 'rm -rf "$tmpdir"' EXIT

cd ./test || exit
export APPROVALS_DIR="$(pwd)/approvals"

shopt -s nullglob

if [[ -n "${usage_spec}" ]]; then
  if [[ ! -f "$usage_spec" ]]; then
    echo "Specified spec file '$usage_spec' does not exist" >&2
    exit 1
  fi
  specs=("$usage_spec")
else
  specs=(*_spec.sh)
fi

node_total=${CI_NODE_TOTAL:-1}
node_index=${CI_NODE_INDEX:-0}

if ((node_total < 1)); then
  echo "CI_NODE_TOTAL must be at least 1" >&2
  exit 1
fi

if ((node_index < 0 || node_index >= node_total)); then
  echo "CI_NODE_INDEX ${node_index} must be between 0 and $((node_total - 1))" >&2
  exit 1
fi

if ((${#specs[@]} == 0)); then
  echo "No spec files found in $(pwd)" >&2
  exit 1
fi

run_test() {
  local file="$1"
  ./test_setup.sh
  context "$file"
  "./$file"
  ./test_cleanup.sh
}

for i in "${!specs[@]}"; do
  file="${specs[$i]}"
  if ((i % node_total == node_index)); then
    if [[ -v GITHUB_ACTIONS ]]; then
      run_test "$file" &
    else
      run_test "$file"
    fi
  fi
done

if [[ -v GITHUB_ACTIONS ]]; then
  wait
fi
